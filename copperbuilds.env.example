# ════════════════════════════════════════════════
#  COPPERBUILDS SITE CONFIG — EXAMPLE
#  Copy this to copperbuilds.env and fill in your values.
#  copperbuilds.env is gitignored — never commit real keys.
# ════════════════════════════════════════════════

# -- SITE INFO ------------------------------------
WEBSITE_URL=https://copperbuilds.com
PHONE=+63 977 329 3969
EMAIL=lantech016@gmail.com

# -- CONTACT FORM ---------------------------------
# Get your free key at https://web3forms.com
WEB3FORMS_KEY=
FORM_SUBJECT=New inquiry from CopperBuilds

# -- GOOGLE ANALYTICS 4 ---------------------------
# Format: G-XXXXXXXXXX
# Get from: analytics.google.com → Admin → Data Streams
GA4_MEASUREMENT_ID=

# -- GOOGLE SEARCH CONSOLE ------------------------
# Paste the content= value from the HTML verification meta tag
# e.g. content="abc123xyz"
GSC_VERIFICATION=

# -- GOOGLE TAG MANAGER ---------------------------
# Format: GTM-XXXXXXX (optional — only if using GTM)
GTM_ID=

# -- AHREFS ---------------------------------------
# Paste the content= value from the Ahrefs verification meta tag
AHREFS_VERIFICATION=

# -- GOOGLE BUSINESS PROFILE ----------------------
# Your GBP Place ID (used in schema markup)
# Find it: maps.google.com → search your business → share → embed → extract ID
GBP_PLACE_ID=
